<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/fragment_container"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.orders.OrdersFragment">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/transparent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cartRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                tools:listitem="@layout/item_cart_product"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="62dp"
                android:layout_gravity="bottom"
                android:background="@color/white"
                android:paddingVertical="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_regular"
                    android:layout_marginStart="50dp"
                    android:text="Deliver to Marius - Whitby L1R 2M5"
                    android:textSize="20sp"
                    android:textColor="#11425D"
                    tools:ignore="HardcodedText,SmallSp" />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/baseline_location_pin_24"
                    android:contentDescription="nothing"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="40dp"
                    android:layout_gravity="center_horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlaceOrder"
                        android:layout_width="wrap_content"
                        android:paddingHorizontal="70dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lato_regular"
                        android:backgroundTint="#F86A01"
                        android:text="Place Your Order"
                        android:layout_marginStart="20dp"
                        app:cornerRadius="0dp"
                        android:layout_marginEnd="5dp"
                        android:layout_gravity="center_horizontal"
                        tools:ignore="ButtonStyle,HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lato_regular"
                        android:drawableEnd="@drawable/baseline_phone_24"
                        android:backgroundTint="@color/white"
                        app:strokeColor="#F86A01"
                        app:strokeWidth="2dp"
                        app:cornerRadius="0dp"
                        android:paddingHorizontal="20dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="20dp"
                        tools:ignore="ButtonStyle" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>