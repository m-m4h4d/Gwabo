<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/food_banner"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ContentDescription"/>

    <HorizontalScrollView
        android:id="@+id/categoryTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/bannerImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingVertical="8dp"
        android:scrollbarSize="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appetizer"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="@color/transparent"
                android:textColor="@color/black"
                android:fontFamily="@font/lato_regular"
                tools:ignore="ButtonStyle,HardcodedText" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Main Course"
                android:layout_marginHorizontal="6dp"
                android:fontFamily="@font/lato_regular"
                android:textColor="@color/white"
                android:backgroundTint="@color/main_200"
                tools:ignore="ButtonStyle,HardcodedText" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dessert"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="@color/transparent"
                android:textColor="@color/black"
                android:fontFamily="@font/lato_regular"
                tools:ignore="ButtonStyle,HardcodedText" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drinks"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="@color/transparent"
                android:textColor="@color/black"
                android:fontFamily="@font/lato_regular"
                tools:ignore="ButtonStyle,HardcodedText" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/todaysSpeciality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's Specialty"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/categoryTabs"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="16dp"
        tools:ignore="HardcodedText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/specialtyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/todaysSpeciality"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_specialty"/>

    <TextView
        android:id="@+id/mainSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Main"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/specialtyRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="16dp"
        tools:ignore="HardcodedText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mainCourseRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mainSectionTitle"
        tools:listitem="@layout/item_main_course" />
</androidx.constraintlayout.widget.ConstraintLayout>
