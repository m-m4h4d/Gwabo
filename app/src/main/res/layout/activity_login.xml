<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="20dp"
    tools:context=".LoginActivity">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:src="@drawable/logo" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inscrivez-vous en 2 minutes"
        android:layout_marginTop="20dp"
        android:textColor="#ffffff"
        android:backgroundTint="#ff4a00"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnGoogleApple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="S'inscrire avec Google ou Apple"
        android:drawableStart="@drawable/google_icon"
        android:drawableEnd="@drawable/apple_icon"
        android:layout_marginTop="10dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#000000"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnFacebook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="S'inscrire avec Facebook"
        android:drawableStart="@drawable/facebook_icon"
        android:layout_marginTop="10dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#000000"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Se connecter"
        android:layout_marginTop="20dp"
        android:backgroundTint="#ff4a00"
        android:textColor="#ffffff"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assistance"
            android:textColor="#0000FF"
            android:layout_marginEnd="20dp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Langues"
            android:textColor="#0000FF"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</LinearLayout>