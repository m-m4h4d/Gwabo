<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.gwabo.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_grocery"
        android:name="com.example.gwabo.ui.groceries.GroceriesFragment"
        android:label="@string/title_grocery"
        tools:layout="@layout/fragment_groceries" />

    <fragment
        android:id="@+id/navigation_restaurant"
        android:name="com.example.gwabo.ui.restaurants.RestaurantsFragment"
        android:label="@string/title_restaurant"
        tools:layout="@layout/fragment_restaurants" />

    <fragment
        android:id="@+id/navigation_orders_list"
        android:name="com.example.gwabo.ui.orders.OrdersFragment"
        android:label="@string/title_orders_list"
        tools:layout="@layout/fragment_orders" />
</navigation>